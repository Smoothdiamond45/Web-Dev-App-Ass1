
{{#each categories}}
  <div class="category-card">
    <div class="card-content">
      <h3 class="card-title">{{this.name}}</h3>
      <p class="card-count">{{this.photos.length}} photos</p>
      <a href="/details/{{this.id}}">View Collection</a>
    </div>
  </div>
{{/each}}
